@section Scripts {
    <script>
        function showAlert(mensaje, tipo = "danger") {
            const container = document.getElementById("alertContainer");

            const alert = document.createElement("div");
            let alertClass = "alert-danger-custom";

            if (tipo === "success") {
                alertClass = "alert-success-custom";
            } else if (tipo === "warning") {
                alertClass = "alert-warning-custom";
            }

            alert.className = `alert-custom ${alertClass}`;

            alert.innerHTML = `
                <span class="alert-message">${mensaje}</span>
                <button type="button" class="alert-close" onclick="closeAlert(this)">×</button>
            `;

            container.appendChild(alert);

            setTimeout(() => {
                if (alert) {
                    alert.style.animation = "fadeOut 0.4s ease forwards";
                    setTimeout(() => {
                        if (alert.parentNode) {
                            alert.remove();
                        }
                    }, 700);
                }
            }, 3000);
        }

        function closeAlert(element) {
            const alert = element.parentElement;
            alert.style.animation = "fadeOut 0.4s ease forwards";
            setTimeout(() => {
                if (alert.parentNode) {
                    alert.remove();
                }
            }, 700);
        }

        function togglePassword(inputId, button) {
            const input = document.getElementById(inputId);
            const img = button.querySelector("img");

            if (!input || !img) return;

            if (input.type === "password") {
                input.type = "text";
                img.src = "/img/OcultarContrasena.png";
                img.alt = "Ocultar contraseña";
            } else {
                input.type = "password";
                img.src = "/img/MostrarContrasena.png";
                img.alt = "Mostrar contraseña";
            }
        }

        function validarCoincidenciaPasswords(passwordId, confirmId, errorId) {
            const password = document.getElementById(passwordId);
            const confirm = document.getElementById(confirmId);
            const error = document.getElementById(errorId);

            if (!password || !confirm || !error) return true;

            const sonIguales = password.value === confirm.value;

            if (confirm.value === "") {
                error.style.display = "none";
                password.classList.remove("input-error");
                confirm.classList.remove("input-error");
                return true;
            }

            if (!sonIguales) {
                error.style.display = "block";
                password.classList.add("input-error");
                confirm.classList.add("input-error");
                return false;
            }

            error.style.display = "none";
            password.classList.remove("input-error");
            confirm.classList.remove("input-error");
            return true;
        }

        function limpiarFormularioCrear() {
            document.getElementById('CrearIdUsuario').value = 0;
            document.getElementById('CrearDocumento').value = '';
            document.getElementById('CrearNombreCompleto').value = '';
            document.getElementById('CrearCorreo').value = '';
            document.getElementById('CrearClave').value = '';
            document.getElementById('CrearConfirmarClave').value = '';
            document.getElementById('CrearIdRol').value = '';
            document.getElementById('CrearEstado').value = '';
            document.getElementById('crearPasswordError').style.display = 'none';
            document.getElementById('CrearClave').classList.remove('input-error');
            document.getElementById('CrearConfirmarClave').classList.remove('input-error');
        }

        function editarUsuario(id, documento, nombre, correo, clave, idRol, estado) {
            document.getElementById('EditarIdUsuario').value = id;
            document.getElementById('EditarDocumento').value = documento;
            document.getElementById('EditarNombreCompleto').value = nombre;
            document.getElementById('EditarCorreo').value = correo;
            document.getElementById('EditarClave').value = clave;
            document.getElementById('EditarConfirmarClave').value = clave;
            document.getElementById('EditarIdRol').value = idRol;
            document.getElementById('EditarEstado').value = estado;
            document.getElementById('editarPasswordError').style.display = 'none';
            document.getElementById('EditarClave').classList.remove('input-error');
            document.getElementById('EditarConfirmarClave').classList.remove('input-error');

            const modal = new bootstrap.Modal(document.getElementById('modalEditarUsuario'));
            modal.show();
        }

        function verDetalle(documento, nombre, correo, clave, rol, estado) {
            document.getElementById('detalleDocumento').innerText = documento;
            document.getElementById('detalleNombre').innerText = nombre;
            document.getElementById('detalleCorreo').innerText = correo;
            document.getElementById('detalleClave').innerText = clave;
            document.getElementById('detalleRol').innerText = rol;
            document.getElementById('detalleEstado').innerText = estado;

            mostrarPermisosPorRol(rol);

            const modal = new bootstrap.Modal(document.getElementById('modalDetalleUsuario'));
            modal.show();
        }

        function mostrarPermisosPorRol(rol) {
            const contenedor = document.getElementById('detallePermisos');

            if (!contenedor) return;

            contenedor.innerHTML = '';

            const rolNormalizado = (rol || '').trim().toUpperCase();

            let permisos = [];

            if (rolNormalizado === 'ADMINISTRADOR') {
                permisos = [
                    'Inicio',
                    'Productos',
                    'Ventas',
                    'Compras',
                    'Clientes',
                    'Proveedores',
                    'Reporte de Compras',
                    'Reporte de Ventas',
                    'Usuarios',
                    'Categoría',
                    'Negocio'
                ];
            } else if (rolNormalizado === 'EMPLEADO') {
                permisos = [
                    'Inicio',
                    'Productos',
                    'Ventas',
                    'Compras',
                    'Clientes',
                    'Proveedores',
                    'Reporte de Compras',
                    'Reporte de Ventas'
                ];
            } else {
                permisos = ['Sin permisos asignados'];
            }

            permisos.forEach(function (permiso) {
                const span = document.createElement('span');
                span.className = 'permiso-chip';
                span.innerText = permiso;
                contenedor.appendChild(span);
            });
        }

        function validarCrearUsuario() {
            const esValido = validarCoincidenciaPasswords('CrearClave', 'CrearConfirmarClave', 'crearPasswordError');

            if (!esValido) {
                showAlert('Las contraseñas deben ser iguales para los 2 campos.', 'warning');
                return false;
            }

            return true;
        }

        function validarEditarUsuario() {
            const esValido = validarCoincidenciaPasswords('EditarClave', 'EditarConfirmarClave', 'editarPasswordError');

            if (!esValido) {
                showAlert('Las contraseñas deben ser iguales para los 2 campos.', 'warning');
                return false;
            }

            return true;
        }

        document.addEventListener('DOMContentLoaded', function () {
            const txtBuscar = document.getElementById('txtBuscar');
            const formBusquedaUsuarios = document.getElementById('formBusquedaUsuarios');
            const crearClave = document.getElementById('CrearClave');
            const crearConfirmar = document.getElementById('CrearConfirmarClave');
            const editarClave = document.getElementById('EditarClave');
            const editarConfirmar = document.getElementById('EditarConfirmarClave');

            if (txtBuscar && formBusquedaUsuarios) {
                let temporizadorBusqueda;
                let ultimoValor = txtBuscar.value;

                txtBuscar.addEventListener('input', function () {
                    clearTimeout(temporizadorBusqueda);

                    const valorActual = this.value;

                    temporizadorBusqueda = setTimeout(function () {
                        if (valorActual !== ultimoValor) {
                            ultimoValor = valorActual;
                            formBusquedaUsuarios.submit();
                        }
                    }, 1000);
                });
            }

            if (crearClave && crearConfirmar) {
                crearClave.addEventListener('input', function () {
                    validarCoincidenciaPasswords('CrearClave', 'CrearConfirmarClave', 'crearPasswordError');
                });

                crearConfirmar.addEventListener('input', function () {
                    validarCoincidenciaPasswords('CrearClave', 'CrearConfirmarClave', 'crearPasswordError');
                });
            }

            if (editarClave && editarConfirmar) {
                editarClave.addEventListener('input', function () {
                    validarCoincidenciaPasswords('EditarClave', 'EditarConfirmarClave', 'editarPasswordError');
                });

                editarConfirmar.addEventListener('input', function () {
                    validarCoincidenciaPasswords('EditarClave', 'EditarConfirmarClave', 'editarPasswordError');
                });
            }
        });
    </script>
}