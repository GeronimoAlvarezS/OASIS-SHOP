        </div>
    </div>
</div>

<!-- MODAL DETALLES -->
<div class="modal fade modal-usuario-custom" id="modalDetalleUsuario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:430px;">
        <div class="modal-content">
            <div class="modal-header-detalle">
                <h5 class="modal-title-custom">DETALLES</h5>
                <button type="button" class="btn-close-custom" data-bs-dismiss="modal" aria-label="Cerrar">×</button>
            </div>

            <div class="modal-body modal-body-usuario">
                <div class="details-container">
                    <div class="details-item">
                        <span class="details-label">Documento</span>
                        <span class="details-value" id="detalleDocumento"></span>
                    </div>

                    <div class="details-item">
                        <span class="details-label">Nombre Completo</span>
                        <span class="details-value" id="detalleNombre"></span>
                    </div>

                    <div class="details-item">
                        <span class="details-label">Correo</span>
                        <span class="details-value" id="detalleCorreo"></span>
                    </div>

                    <div class="details-item">
                        <span class="details-label">Contraseña</span>
                        <span class="details-value" id="detalleClave"></span>
                    </div>

                    <div class="details-item">
                        <span class="details-label">Rol</span>
                        <span class="details-value" id="detalleRol"></span>
                    </div>

                    <div class="details-item details-permissions">
                        <span class="details-label">Permisos</span>
                        <div id="detallePermisos" class="permisos-container"></div>
                    </div>

                    <div class="details-item">
                        <span class="details-label">Estado</span>
                        <span class="details-value" id="detalleEstado"></span>
                    </div>

                    <div class="details-footer">
                        <button type="button" class="btn-close-detail" data-bs-dismiss="modal">Cerrar</button>
                    </div>
                </div>
