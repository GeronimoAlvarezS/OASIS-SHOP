                        <label class="modal-label" for="EditarEstado">Estado</label>
                        <select class="modal-select" id="EditarEstado" name="Estado" required>
                            <option value="">SELECCIONE</option>
                            <option value="true">Activo</option>
                            <option value="false">Inactivo</option>
                        </select>
                    </div>

                    <div class="modal-footer-custom">
                        <button type="submit" class="btn-save-modal">Editar</button>
                    </div>
                </div>
