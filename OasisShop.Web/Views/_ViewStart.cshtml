using Microsoft.Playwright;
using Microsoft.Playwright.NUnit;
using NUnit.Framework;
using System.Threading.Tasks;

namespace PruebasUI
{
[Parallelizable(ParallelScope.Self)]
[TestFixture]
public class LoginTests : PageTest
{
[Test]
public async Task Login_ConCredencialesValidas_DebeIngresarAlSistema()
{
// 1. Ir a la página (Asegúrate que OasisShop esté corriendo)
await Page.GotoAsync("https://localhost:7238/");

// 2. Usamos los textos que se ven en tu imagen del login
// Documento de identidad: 10 | Contraseña: 1234
await Page.GetByLabel("Documento de identidad").FillAsync("10");
await Page.GetByLabel("Contraseña").FillAsync("1234");

// 3. Hacer clic en el botón morado
await Page.GetByRole(AriaRole.Button, new() { Name = "Iniciar Sesión" }).ClickAsync();

// 4. Esperar a que entre al sistema
// Cambia "Cerrar Sesión" por algún texto que aparezca solo al entrar
await Expect(Page.Locator("text=Cerrar Sesión")).ToBeVisibleAsync();
}
}
}