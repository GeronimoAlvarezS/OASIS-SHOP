                               id="EditarCorreo"
                               name="Correo"
                               required
                               autocomplete="off" />
                    </div>

                    <div class="modal-group">
                        <label class="modal-label" for="EditarTelefono">Teléfono</label>
                        <input type="text"
                               class="modal-input"
                               id="EditarTelefono"
                               name="Telefono"
                               required
                               autocomplete="off" />
                    </div>

                    <div class="modal-group">
                        <label class="modal-label" for="EditarDireccion">Dirección</label>
