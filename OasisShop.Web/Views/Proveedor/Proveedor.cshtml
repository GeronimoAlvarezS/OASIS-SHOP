    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header-editar">
                <h5 class="modal-title-custom">EDITAR PROVEEDOR</h5>
                <button type="button"
                        class="btn-close-custom"
