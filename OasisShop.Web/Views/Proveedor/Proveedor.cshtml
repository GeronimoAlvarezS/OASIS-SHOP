                <div class="modal-body modal-body-proveedor">
                    <input type="hidden" id="EditarIdProveedor" name="IdProveedor" value="0" />

                    <div class="modal-group">
                        <label class="modal-label" for="EditarDocumento">Documento</label>
                        <input type="text"
                               class="modal-input"
                               id="EditarDocumento"
                               name="Documento"
