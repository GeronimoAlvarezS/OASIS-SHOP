<!-- MODAL DETALLES -->
<div class="modal fade modal-proveedor-custom" id="modalDetalleProveedor" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:430px;">
        <div class="modal-content">
            <div class="modal-header-detalle">
                <h5 class="modal-title-custom">DETALLES</h5>
                <button type="button"
                        class="btn-close-custom"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                    ×
                </button>
            </div>

            <div class="modal-body modal-body-proveedor">
                <div class="details-container">
                    <div class="details-item">
                        <span class="details-label">Documento</span>
                        <span class="details-value" id="detalleDocumento">---</span>
                    </div>

                    <div class="details-item">
                        <span class="details-label">Razón social</span>
                        <span class="details-value" id="detalleRazonSocial">---</span>
                    </div>

                    <div class="details-item">
                        <span class="details-label">Correo</span>
                        <span class="details-value" id="detalleCorreo">---</span>
                    </div>

                    <div class="details-item">
                        <span class="details-label">Teléfono</span>
                        <span class="details-value" id="detalleTelefono">---</span>
                    </div>

                    <div class="details-item">
                        <span class="details-label">Dirección</span>
                        <span class="details-value" id="detalleDireccion">---</span>
                    </div>

                    <div class="details-item">
                        <span class="details-label">Estado</span>
                        <span class="details-value" id="detalleEstado">---</span>
                    </div>

                    <div class="details-item">
                        <span class="details-label">Compras asociadas</span>
                        <span class="details-value" id="detalleRelacionCompras">---</span>
                    </div>

                    <div class="details-footer">
                        <button type="button"
                                class="btn-close-detail"
                                data-bs-dismiss="modal">
                            Cerrar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showAlert(mensaje, tipo = "danger") {
            const container = document.getElementById("alertContainer");

            const alert = document.createElement("div");
            let alertClass = "alert-danger-custom";

            if (tipo === "success") {
                alertClass = "alert-success-custom";
            } else if (tipo === "warning") {
                alertClass = "alert-warning-custom";
            }

            alert.className = `alert-custom ${alertClass}`;

            alert.innerHTML = `
                <span class="alert-message">${mensaje}</span>
                <button type="button" class="alert-close" onclick="closeAlert(this)">×</button>
            `;

            container.appendChild(alert);

                    setTimeout(() => {
            if (alert) {
                alert.style.animation = "fadeOut 0.5s ease forwards";

                setTimeout(() => {
                    if (alert.parentNode) {
                        alert.remove();
                    }
                }, 500);
            }
                }, 5000);
        }

        function closeAlert(element) {
            const alert = element.parentElement;
            alert.style.animation = "fadeOut 0.4s ease forwards";

            setTimeout(() => {
                if (alert.parentNode) {
                    alert.remove();
                }
            }, 800);
        }

        function limpiarFormularioCrearProveedor() {
            document.getElementById("CrearIdProveedor").value = 0;
            document.getElementById("CrearDocumento").value = "";
            document.getElementById("CrearRazonSocial").value = "";
            document.getElementById("CrearCorreo").value = "";
            document.getElementById("CrearTelefono").value = "";
            document.getElementById("CrearDireccion").value = "";
            document.getElementById("CrearEstado").value = "";
        }

        function editarProveedor(id, documento, razonSocial, correo, telefono, direccion, estado) {
            document.getElementById("EditarIdProveedor").value = id;
            document.getElementById("EditarDocumento").value = documento;
            document.getElementById("EditarRazonSocial").value = razonSocial;
            document.getElementById("EditarCorreo").value = correo;
            document.getElementById("EditarTelefono").value = telefono || "";
            document.getElementById("EditarDireccion").value = direccion || "";
            document.getElementById("EditarEstado").value = estado === "true" ? "true" : "false";

            const modal = new bootstrap.Modal(document.getElementById("modalEditarProveedor"));
            modal.show();
        }

        function verDetalleProveedor(documento, razonSocial, correo, telefono, direccion, estado, tieneCompras) {
            document.getElementById("detalleDocumento").innerText = documento || "---";
            document.getElementById("detalleRazonSocial").innerText = razonSocial || "---";
            document.getElementById("detalleCorreo").innerText = correo || "---";
            document.getElementById("detalleTelefono").innerText = telefono || "No registrado";
            document.getElementById("detalleDireccion").innerText = direccion || "No registrada";
            document.getElementById("detalleEstado").innerText = estado || "---";

            document.getElementById("detalleRelacionCompras").innerText =
                tieneCompras === "true"
                    ? "Proveedor con compras registradas"
                    : "Este proveedor no tiene compras registradas";

            const modal = new bootstrap.Modal(document.getElementById("modalDetalleProveedor"));
            modal.show();
        }

        function validarCrearProveedor() {
            const documento = document.getElementById("CrearDocumento").value.trim();
            const razon = document.getElementById("CrearRazonSocial").value.trim();
            const correo = document.getElementById("CrearCorreo").value.trim();
            const telefono = document.getElementById("CrearTelefono").value.trim();
            const direccion = document.getElementById("CrearDireccion").value.trim();
            const estado = document.getElementById("CrearEstado").value;

            if (documento === "" || razon === "" || correo === "" || telefono === "" || direccion === "" || estado === "") {
                showAlert("Todos los campos son obligatorios.", "warning");
                return false;
            }

            return true;
        }

        function validarEditarProveedor() {
            const documento = document.getElementById("EditarDocumento").value.trim();
            const razon = document.getElementById("EditarRazonSocial").value.trim();
            const correo = document.getElementById("EditarCorreo").value.trim();
            const telefono = document.getElementById("EditarTelefono").value.trim();
            const direccion = document.getElementById("EditarDireccion").value.trim();
            const estado = document.getElementById("EditarEstado").value;

            if (documento === "" || razon === "" || correo === "" || telefono === "" || direccion === "" || estado === "") {
                showAlert("Todos los campos son obligatorios.", "warning");
                return false;
            }

            return true;
        }

        function guardarProveedorAjax(formulario, modalId) {
            const formData = new FormData(formulario);

            fetch(formulario.action, {
                method: "POST",
                body: formData
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showAlert(data.mensaje || "Operación realizada correctamente.", "success");

                        const modalElement = document.getElementById(modalId);
                        const modal = bootstrap.Modal.getInstance(modalElement);

                        if (modal) {
                            modal.hide();
                        }

                        setTimeout(() => {
                            location.reload();
                        }, 1000);
                    } else {
                        showAlert(data.mensaje || "No se pudo procesar la solicitud.", "danger");
                    }
                })
                .catch(() => {
                    showAlert("Error al procesar la solicitud.", "danger");
                });
        }

        document.addEventListener("DOMContentLoaded", function () {
            const formCrear = document.getElementById("formCrearProveedor");
            const formEditar = document.getElementById("formEditarProveedor");

            if (formCrear) {
                formCrear.addEventListener("submit", function (e) {
                    e.preventDefault();

                    if (!validarCrearProveedor()) {
                        return;
                    }

                    guardarProveedorAjax(formCrear, "modalCrearProveedor");
                });
            }

            if (formEditar) {
                formEditar.addEventListener("submit", function (e) {
                    e.preventDefault();

                    if (!validarEditarProveedor()) {
                        return;
                    }

                    guardarProveedorAjax(formEditar, "modalEditarProveedor");
                });
            }

            const buscador = document.getElementById("txtBuscar");

            if (buscador) {
                buscador.addEventListener("keyup", function () {
                    const filtro = this.value.toLowerCase();
                    const filas = document.querySelectorAll("#tablaProveedores tr");
                    let encontrados = 0;

                    filas.forEach(function (fila) {
                        const texto = fila.innerText.toLowerCase();

                        if (texto.includes(filtro)) {
                            fila.style.display = "";
                            encontrados++;
                        } else {
                            fila.style.display = "none";
                        }
                    });

                    const mensaje = document.getElementById("mensajeSinResultados");

                    if (mensaje) {
                        mensaje.style.display = encontrados === 0 ? "block" : "none";
                    }
                });
            }
        });
    </script>
}