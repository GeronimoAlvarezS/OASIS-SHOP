@model OasisShop.Web.Models.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Iniciar sesión";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>OASIS SHOP - Login</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
            * {
                box-sizing: border-box;
            }

            html, body {
                height: 100%;
                margin: 0;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            /* 🔥 AQUÍ SE CORRIGE EL FONDO */
            body {
                background: url('/img/FondoLogin.png') no-repeat center center fixed;
                background-size: cover;
                display: flex;
                justify-content: center;
                align-items: center;
            }

            .login-wrapper {
                width: 100%;
                max-width: 1000px;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 20px;
            }

            .login-card {
                width: 100%;
                max-width: 320px;
                background-color: #F8F8F8;
                border-radius: 18px;
                padding: 28px 24px 20px 24px;
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.18);
            }

            .logo-container {
                text-align: center;
                margin-bottom: 18px;
            }

                .logo-container img {
                    width: 150px;
                    max-width: 100%;
                    height: auto;
                }

            .login-title {
                font-size: 18px;
                font-weight: 700;
                color: #111111;
                margin-bottom: 22px;
            }

            .form-group-custom {
                margin-bottom: 18px;
            }

            .form-label-custom {
                display: block;
                font-size: 13px;
                font-weight: 600;
                color: #1E1E1E;
                margin-bottom: 6px;
            }

            .input-icon-group {
                display: flex;
                align-items: center;
                width: 100%;
                height: 30px;
                border: 1px solid #8D8D8D;
                border-radius: 5px;
                background-color: #FFFFFF;
                overflow: hidden;
            }

            .input-icon {
                width: 34px;
                min-width: 34px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #7A7A7A;
                font-size: 14px;
                border-right: 1px solid #D7D7D7;
                background-color: #FFFFFF;
            }

            .input-custom {
                border: none;
                outline: none;
                width: 100%;
                height: 100%;
                padding: 4px 10px;
                font-size: 13px;
                background-color: transparent;
                color: #222222;
            }

            .btn-login {
                width: 100%;
                height: 32px;
                border: none;
                border-radius: 5px;
                background-color: #3C227B;
                color: #FFFFFF;
                font-size: 13px;
                font-weight: 600;
                margin-top: 10px;
            }

            .login-footer {
                text-align: center;
                margin-top: 18px;
                font-size: 13px;
                color: #666666;
            }

                .login-footer a {
                    color: #6B4BFF;
                    text-decoration: none;
                    font-weight: 500;
                }
    </style>
</head>
<body>
    <div class="login-wrapper">
        <div class="login-card">

            
            <div class="logo-container">
                <img src="/img/LogoOasis.png" alt="OASIS SHOP" />
            </div>

            <div class="login-title">Iniciar Sesión</div>

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group-custom">
                    <label asp-for="Documento">Documento de identidad</label>
                    <div class="input-icon-group">
                        <div class="input-icon">👤</div>
                        <input asp-for="Documento" class="input-custom" />
                    </div>
                </div>

                <div class="form-group-custom">
                    <label asp-for="Clave">Contraseña</label>
                    <div class="input-icon-group">
                        <div class="input-icon">🔒</div>
                        <input asp-for="Clave" type="password" class="input-custom" />
                    </div>
                </div>

                <button type="submit" class="btn-login">Iniciar Sesión</button>

                <div class="login-footer">
                    ¿No tienes cuenta? <a href="#">Contacta al administrador</a>
                </div>
            </form>

        </div>
    </div>
</body>
</html>