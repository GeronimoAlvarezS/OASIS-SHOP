<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - OASIS SHOP</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body style="background-color:#F5F7FA;">
    <div class="d-flex">
        <aside class="text-white p-3" style="width:260px; min-height:100vh; background-color:#1E1B4B;">
            <h3 class="mb-4">OASIS SHOP</h3>

            <ul class="nav flex-column">
                <li class="nav-item mb-2">
                    <a class="nav-link text-white" asp-controller="Home" asp-action="Index">Inicio</a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link text-white" asp-controller="Auth" asp-action="Logout">Cerrar sesión</a>
                </li>
            </ul>
        </aside>

        <main class="flex-grow-1 p-4">
            @RenderBody()
        </main>
    </div>
</body>
</html>