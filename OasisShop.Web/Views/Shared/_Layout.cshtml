@using Microsoft.AspNetCore.Http
@using System
@using System.Linq
@inject IHttpContextAccessor HttpContextAccessor

@{
    var permisosTexto = HttpContextAccessor.HttpContext.Session.GetString("Permisos") ?? string.Empty;
    var nombreCompleto = HttpContextAccessor.HttpContext.Session.GetString("NombreCompleto") ?? "Usuario";

    var permisos = permisosTexto
        .Split(',', StringSplitOptions.RemoveEmptyEntries)
        .Select(p => p.Trim().ToLower())
        .ToList();

    var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var accionActual = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    string ClaseActiva(string controlador, string accion = "Index")
    {
        return controladorActual.Equals(controlador, StringComparison.OrdinalIgnoreCase)
            && accionActual.Equals(accion, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : string.Empty;
    }

    bool TienePermiso(string permiso)
    {
        return permisos.Contains(permiso.Trim().ToLower());
    }

    bool EsModuloActual(params string[] controladores)
    {
        return controladores.Any(c => controladorActual.Equals(c, StringComparison.OrdinalIgnoreCase));
    }

    string MostrarMenu(bool condicion)
    {
        return condicion ? "show" : string.Empty;
    }

    string MenuExpandido(bool condicion)
    {
        return condicion ? "true" : "false";
    }
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - OASIS SHOP</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@300..700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
            * {
                box-sizing: border-box;
                font-family: 'Fredoka', sans-serif;
            }

            html, body {
                height: 100%;
                margin: 0;
                background: #ECEDEF;
            }

            body {
                overflow: hidden;
            }

            h1, h2, h3, h4, h5, h6 {
                font-weight: 700;
            }

            button,
            .nav-link-custom,
            .logout-btn {
                font-weight: 400;
            }

            .app-container {
                display: flex;
                width: 100%;
                height: 100vh;
            }

            .sidebar {
                width: 270px;
                min-width: 270px;
                background: #1E1B4B;
                color: #FFFFFF;
                display: flex;
                flex-direction: column;
                padding: 16px 12px 18px 12px;
                height: 100vh;
                overflow-y: auto;
                overflow-x: hidden;
                transition: all 0.25s ease;
                scroll-behavior: auto;
            }

                .sidebar::-webkit-scrollbar {
                    width: 6px;
                }

                .sidebar::-webkit-scrollbar-thumb {
                    background: #4B43D1;
                    border-radius: 10px;
                }

            .app-container.sidebar-hidden .sidebar {
                width: 0;
                min-width: 0;
                padding-left: 0;
                padding-right: 0;
                overflow: hidden;
            }

            .menu-section-title {
                font-size: 16px;
                font-weight: 700;
                color: #8E8C9E;
                margin: 18px 0 10px 10px;
                white-space: nowrap;
            }

            .nav-custom {
                list-style: none;
                padding: 0;
                margin: 0;
            }

            .nav-item-custom {
                margin-bottom: 8px;
            }

            .nav-link-custom {
                display: flex;
                align-items: center;
                gap: 12px;
                color: #FFFFFF;
                text-decoration: none;
                padding: 11px 14px;
                border-radius: 8px;
                font-size: 17px;
                font-weight: 500;
                transition: background-color .2s ease;
                white-space: nowrap;
                overflow: hidden;
                width: 100%;
                border: none;
                background: transparent;
                text-align: left;
            }

                .nav-link-custom:hover {
                    background: rgba(255,255,255,.08);
                    color: #FFFFFF;
                }

                .nav-link-custom.active {
                    background: #4B43D1;
                    color: #FFFFFF;
                }

            .nav-icon {
                width: 22px;
                min-width: 22px;
                height: 22px;
                display: flex;
                align-items: center;
                justify-content: center;
                overflow: hidden;
                flex-shrink: 0;
            }

            .nav-img-icon {
                width: 16px;
                height: 16px;
                max-width: 100%;
                max-height: 100%;
                object-fit: contain;
                display: block;
            }

            .nav-arrow {
                margin-left: auto;
                font-size: 18px;
                font-weight: 600;
                line-height: 1;
                transition: transform .2s ease;
            }

            .nav-link-custom[aria-expanded="true"] .nav-arrow {
                transform: rotate(90deg);
            }

            .submenu-custom {
                padding-left: 34px;
                margin-top: 6px;
            }

            .submenu-link-custom {
                display: block;
                color: #FFFFFF;
                text-decoration: none;
                padding: 8px 10px;
                border-radius: 7px;
                font-size: 16px;
                font-weight: 500;
                margin-bottom: 4px;
                transition: background-color .2s ease;
                white-space: nowrap;
            }

                .submenu-link-custom:hover {
                    background: rgba(255,255,255,.08);
                    color: #FFFFFF;
                }

                .submenu-link-custom.active {
                    background: #2B286F;
                    color: #FFFFFF;
                }

            .main-container {
                flex: 1;
                display: flex;
                flex-direction: column;
                min-width: 0;
                background: #ECEDEF;
                transition: all 0.25s ease;
            }

            .topbar {
                height: 62px;
                background: #F5F5F5;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 22px;
                border-bottom: 1px solid #D8D8D8;
                position: relative;
            }

            .menu-toggle {
                font-size: 34px;
                color: #111111;
                line-height: 1;
                cursor: pointer;
                user-select: none;
                background: transparent;
                border: none;
                padding: 0;
            }

            .topbar-user-wrapper {
                position: relative;
                display: flex;
                flex-direction: column;
                align-items: flex-end;
            }

            .topbar-user {
                display: flex;
                align-items: center;
                gap: 10px;
                color: #111111;
                font-size: 16px;
                font-weight: 500;
                background: transparent;
                border: none;
                cursor: pointer;
                padding: 0;
            }

                .topbar-user .arrow {
                    font-size: 22px;
                    font-weight: 400;
                    line-height: 1;
                    display: inline-block;
                    transition: transform 0.2s ease;
                }

            .topbar-user-wrapper.open .arrow {
                transform: rotate(90deg);
            }

            .user-dropdown {
                position: absolute;
                top: calc(100% + 10px);
                right: 0;
                min-width: 180px;
                display: none;
                z-index: 2000;
            }

            .topbar-user-wrapper.open .user-dropdown {
                display: block;
            }

            .logout-btn {
                width: 100%;
                border: none;
                background: #3C227B;
                color: #FFFFFF;
                font-size: 14px;
                font-weight: 700;
                border-radius: 4px;
                padding: 10px 14px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                text-decoration: none;
                box-shadow: 0 4px 10px rgba(0,0,0,0.18);
            }

                .logout-btn:hover {
                    background: #2f1b61;
                    color: #FFFFFF;
                }

            .page-content {
                flex: 1;
                overflow-y: auto;
                padding: 20px;
            }

            @@media (max-width: 768px) {
                .sidebar {
                    position: fixed;
                    left: 0;
                    top: 0;
                    z-index: 1200;
                    width: 270px;
                    min-width: 270px;
                    transition: transform 0.25s ease;
                }

                .app-container.sidebar-hidden .sidebar {
                    width: 270px;
                    min-width: 270px;
                    padding-left: 12px;
                    padding-right: 12px;
                    transform: translateX(-100%);
                }

                .topbar {
                    padding: 0 16px;
                }

                body, span, div, p, a, button {
                    font-weight: 400 !important;
                }

                h1, h2, h3, h4, h5, h6 {
                    font-weight: 700 !important;
                }

                .topbar-user,
                .topbar-user span {
                    font-weight: 400 !important;
                }

                    .topbar-user .arrow {
                        font-size: 22px;
                        font-weight: 300 !important;
                        opacity: 0.7;
                    }
            }
    </style>
</head>
<body>
    <div class="app-container" id="appContainer">
        <aside class="sidebar" id="sidebar">

            <ul class="nav-custom">
                <li class="nav-item-custom">
                    <a class="nav-link-custom @ClaseActiva("Home")" asp-controller="Home" asp-action="Index">
                        <span class="nav-icon">
                            <img src="~/img/menuInicio.png" alt="Inicio" class="nav-img-icon" />
                        </span>
                        <span>Inicio</span>
                    </a>
                </li>
            </ul>

            <div class="menu-section-title">Gestión</div>

            <ul class="nav-custom">
                @if (TienePermiso("menuproductos"))
                {
                    <li class="nav-item-custom">
                        <a class="nav-link-custom @ClaseActiva("Producto")" asp-controller="Producto" asp-action="Index">
                            <span class="nav-icon">
                                <img src="~/img/Productos.png" alt="Productos" class="nav-img-icon" />
                            </span>
                            <span>Productos</span>
                        </a>
                    </li>
                }

                @if (TienePermiso("menuventas"))
                {
                    var ventasActivo = EsModuloActual("Ventas", "Venta");

                    <li class="nav-item-custom">
                        <button class="nav-link-custom @(ventasActivo ? "active" : string.Empty)"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#submenuVentas"
                                aria-expanded="@MenuExpandido(ventasActivo)"
                                aria-controls="submenuVentas">
                            <span class="nav-icon">
                                <img src="~/img/Ventas.png" alt="Ventas" class="nav-img-icon" />
                            </span>
                            <span>Ventas</span>
                            <span class="nav-arrow">›</span>
                        </button>

                        <div class="collapse submenu-custom @MostrarMenu(ventasActivo)" id="submenuVentas">
                            <a class="submenu-link-custom @ClaseActiva("Venta", "Index")"
                                   asp-controller="Venta"
                                   asp-action="Index">
                                Registrar Ventas
                            </a>

                            <a class="submenu-link-custom @ClaseActiva("Ventas", "Detalle")"
                                   asp-controller="Ventas"
                                   asp-action="Detalle">
                                Detalle de Ventas
                            </a>
                        </div>
                    </li>
                }

                @if (TienePermiso("menucompras"))
                {
                    var comprasActivo = EsModuloActual("Compras", "Compra");

                    <li class="nav-item-custom">
                        <button class="nav-link-custom @(comprasActivo ? "active" : string.Empty)"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#submenuCompras"
                                aria-expanded="@MenuExpandido(comprasActivo)"
                                aria-controls="submenuCompras">
                            <span class="nav-icon">
                                <img src="~/img/Compras.png" alt="Compras" class="nav-img-icon" />
                            </span>
                            <span>Inventario</span>
                            <span class="nav-arrow">›</span>
                        </button>

                        <div class="collapse submenu-custom @MostrarMenu(comprasActivo)" id="submenuCompras">
                            <a class="submenu-link-custom @ClaseActiva("Compras", "Index")"
                                   asp-controller="Compra"
                                   asp-action="Index">
                                Registrar Inventario
                            </a>

                            <a class="submenu-link-custom @ClaseActiva("Compras", "Detalle")"
                                   asp-controller="DetalleDeCompra"
                                   asp-action="Index">
                                Detalle de Inventario
                            </a>
                        </div>
                    </li>
                }

                @if (TienePermiso("menuclientes"))
                {
                    <li class="nav-item-custom">
                        <a class="nav-link-custom @ClaseActiva("Cliente")" asp-controller="Cliente" asp-action="Index">
                            <span class="nav-icon">
                                <img src="~/img/Clientes.png" alt="Clientes" class="nav-img-icon" />
                            </span>
                            <span>Clientes</span>
                        </a>
                    </li>
                }

                @if (TienePermiso("menuproveedores"))
                {
                    <li class="nav-item-custom">
                        <a class="nav-link-custom @ClaseActiva("Proveedor")" asp-controller="Proveedor" asp-action="Index">
                            <span class="nav-icon">
                                <img src="~/img/Proveedores.png" alt="Proveedores" class="nav-img-icon" />
                            </span>
                            <span>Proveedores</span>
                        </a>
                    </li>
                }
            </ul>

            <div class="menu-section-title">Reportes</div>

            <ul class="nav-custom">
                @if (TienePermiso("menucompras"))
                {
                    <li class="nav-item-custom">
                        <a class="nav-link-custom @ClaseActiva("ReporteCompras")" asp-controller="ReporteCompras" asp-action="Index">
                            <span class="nav-icon">
                                <img src="~/img/ReporteCompras.png" alt="Reporte Compras" class="nav-img-icon" />
                            </span>
                            <span>Compras</span>
                        </a>
                    </li>
                }

                @if (TienePermiso("menuventas"))
                {
                    <li class="nav-item-custom">
                        <a class="nav-link-custom @ClaseActiva("ReporteVentas")" asp-controller="ReporteVentas" asp-action="Index">
                            <span class="nav-icon">
                                <img src="~/img/ReporteVentas.png" alt="Reporte Ventas" class="nav-img-icon" />
                            </span>
                            <span>Ventas</span>
                        </a>
                    </li>
                }
            </ul>

            <div class="menu-section-title">Configuración</div>

            <ul class="nav-custom">
                @if (TienePermiso("menuusuarios"))
                {
                    <li class="nav-item-custom">
                        <a class="nav-link-custom @ClaseActiva("Usuario")" asp-controller="Usuario" asp-action="Index">
                            <span class="nav-icon">
                                <img src="~/img/Usuarios.png" alt="Usuarios" class="nav-img-icon" />
                            </span>
                            <span>Usuarios</span>
                        </a>
                    </li>
                }

                @if (TienePermiso("menucategorias"))
                {
                    <li class="nav-item-custom">
                        <a class="nav-link-custom @ClaseActiva("Categoria")" asp-controller="Categoria" asp-action="Index">
                            <span class="nav-icon">
                                <img src="~/img/Categoria.png" alt="Categoria" class="nav-img-icon" />
                            </span>
                            <span>Categoría</span>
                        </a>
                    </li>
                }

                @if (TienePermiso("menunegocio"))
                {
                    <li class="nav-item-custom">
                        <a class="nav-link-custom @ClaseActiva("Negocio")" asp-controller="Negocio" asp-action="Index">
                            <span class="nav-icon">
                                <img src="~/img/Negocio.png" alt="Negocio" class="nav-img-icon" />
                            </span>
                            <span>Negocio</span>
                        </a>
                    </li>
                }
            </ul>
        </aside>

        <main class="main-container">
            <div class="topbar">
                <button type="button" class="menu-toggle" id="btnToggleSidebar">☰</button>

                <div class="topbar-user-wrapper" id="userDropdownWrapper">
                    <button type="button" class="topbar-user" id="btnUserDropdown">
                        <span>@nombreCompleto</span>
                        <span class="arrow">&gt;</span>
                    </button>

                    <div class="user-dropdown">
                        <a asp-controller="Auth" asp-action="Logout" class="logout-btn">
                            <span>Cerrar sesión</span>
                            <span class="nav-icon">
                                <img src="~/img/CerrarSesion.png" alt="Cerrar Sesión" class="nav-img-icon" />
                            </span>
                        </a>
                    </div>
                </div>
            </div>

            <div class="page-content">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
            document.addEventListener('DOMContentLoaded', function () {
                const appContainer = document.getElementById('appContainer');
                const sidebar = document.getElementById('sidebar');
                const btnToggleSidebar = document.getElementById('btnToggleSidebar');
                const userDropdownWrapper = document.getElementById('userDropdownWrapper');
                const btnUserDropdown = document.getElementById('btnUserDropdown');

                const sidebarScrollKey = 'oasisShopSidebarScroll';
                const sidebarHiddenKey = 'oasisShopSidebarHidden';

                if (sidebar) {
                    const scrollGuardado = localStorage.getItem(sidebarScrollKey);

                    if (scrollGuardado !== null) {
                        setTimeout(function () {
                            sidebar.scrollTop = parseInt(scrollGuardado, 10);
                        }, 0);
                    }

                    sidebar.addEventListener('scroll', function () {
                        localStorage.setItem(sidebarScrollKey, sidebar.scrollTop);
                    });

                    const menuLinks = sidebar.querySelectorAll('a.nav-link-custom, a.submenu-link-custom');

                    menuLinks.forEach(function (link) {
                        link.addEventListener('click', function () {
                            localStorage.setItem(sidebarScrollKey, sidebar.scrollTop);
                        });
                    });
                }

                if (appContainer) {
                    const sidebarOculto = localStorage.getItem(sidebarHiddenKey);

                    if (sidebarOculto === 'true') {
                        appContainer.classList.add('sidebar-hidden');
                    }
                }

                if (btnToggleSidebar && appContainer) {
                    btnToggleSidebar.addEventListener('click', function () {
                        appContainer.classList.toggle('sidebar-hidden');

                        const estaOculto = appContainer.classList.contains('sidebar-hidden');
                        localStorage.setItem(sidebarHiddenKey, estaOculto ? 'true' : 'false');
                    });
                }

                if (btnUserDropdown) {
                    btnUserDropdown.addEventListener('click', function (event) {
                        event.stopPropagation();
                        userDropdownWrapper.classList.toggle('open');
                    });
                }

                document.addEventListener('click', function (event) {
                    if (userDropdownWrapper && !userDropdownWrapper.contains(event.target)) {
                        userDropdownWrapper.classList.remove('open');
                    }
                });
            });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>